{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackhands.github.io/eb-keep-logs/reference/json/failures.schema.json",
  "title": "eb-keep-logs failures --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "root", "package", "target", "since", "until", "counts", "failures"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "failures" },
    "root": { "type": "string" },
    "package": { "type": ["string", "null"] },
    "target": { "type": ["string", "null"] },
    "since": { "type": ["string", "null"] },
    "until": { "type": ["string", "null"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "failed"],
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "target", "name", "package", "easyconfig", "step", "message", "duration_s", "log"],
      "properties": {
        "run": { "type": "string" },
        "target": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "package": { "type": ["string", "null"] },
        "easyconfig": { "type": ["string", "null"] },
        "step": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "duration_s": { "type": ["integer", "null"], "minimum": 0 },
        "log": { "type": "string" }
      }
    }
  }
}
