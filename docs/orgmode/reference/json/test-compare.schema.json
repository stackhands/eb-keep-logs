{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackhands.github.io/eb-keep-logs/reference/json/test-compare.schema.json",
  "title": "eb-keep-logs test-compare --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "bundle_count", "differing_fields"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "test-compare" },
    "bundle_count": { "type": "integer", "minimum": 2 },
    "differing_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "values"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/value_group" }
        }
      }
    },
    "value_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "bundles"],
      "properties": {
        "value": { "type": "string" },
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
