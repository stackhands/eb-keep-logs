{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackhands.github.io/eb-keep-logs/reference/json/loads.schema.json",
  "title": "eb-keep-logs loads --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "module", "loads"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "loads" },
    "module": { "type": "string" },
    "loads": {
      "type": "array",
      "items": { "$ref": "#/$defs/load" }
    }
  },
  "$defs": {
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "host", "time", "path"],
      "properties": {
        "user": { "type": "string" },
        "host": { "type": "string" },
        "time": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}