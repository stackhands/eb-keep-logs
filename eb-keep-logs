#!/bin/bash
# eb-keep-logs: keep the logs of EasyBuild builds that a build pipeline would
# otherwise lose, and keep the pipeline's log tree bounded.
#
# A failed build's log is in EasyBuild's tmpdir on the build node, which goes
# with the job; and EasyBuild wraps the "Results of the build can be found in
# the log file(s)" line, so parsing stdout for the path finds nothing.
# `eb --last-log` gives the path, on one line with the basic output style.
set -uo pipefail

VERSION=0.1.0

# src/main.zig's usage_text holds the same text: tests/differential.sh
# compares the two.
usage() {
    cat <<'EOF'
eb-keep-logs: keep the logs of EasyBuild builds that a build pipeline would
otherwise lose, and keep the pipeline's log tree bounded.

  eb-keep-logs failed STATUS NAME LOGDIR [TMP_LOGDIR]
      After `eb` returned STATUS for easyconfig NAME: when STATUS is not 0,
      copy the EasyBuild session log `eb --last-log` names, the failing
      command's output and a meson testlog next to LOGDIR/NAME.stdout.log,
      closed to others and listed in LOGDIR/.licensed-logs. TMP_LOGDIR is
      the --tmp-logdir eb ran with; without it, the newest log in
      EasyBuild's default place is used, unless it is another build's.
      NAME.stdout.log and a TMP_LOGDIR below LOGDIR are closed to others too.
  eb-keep-logs rotate ROOT --compress-after DAYS [--delete-after DAYS]
                           [--lock-timeout SECONDS]
      In the run directories directly under ROOT (named YYYYMMDD_HHMMSS),
      gzip the *.log and *.txt files of old runs and remove older runs
      whole, leaving alone a run that is still written into. A run's age is
      in days from the local midnight of the date in its name. Permissions
      and .licensed-logs follow. One rotate of ROOT runs at a time, holding
      ROOT/.eb-keep-logs-rotate.lock. Options and ROOT come in any order.
      --compress-after DAYS, --compress-after=DAYS
          Gzip the files of runs at least DAYS old. Required; there is no
          default.
      --delete-after DAYS, --delete-after=DAYS
          Remove whole runs at least DAYS old; DAYS must be larger than
          that of --compress-after. Default: none; no run is removed. An
          empty value is the default.
      --lock-timeout SECONDS, --lock-timeout=SECONDS
          While another rotate holds the lock, wait up to SECONDS for it,
          then give up and exit 75. Default: 600; 0 does not wait. An empty
          value is the default.
  eb-keep-logs why [RUN | --latest] [--target TARGET] [--root ROOT] [--json]
      Say why the builds of a run failed: for each failed easyconfig, its
      package and easyconfig, the EasyBuild step it failed in, EasyBuild's
      message, and the line of its kept log that shows the error: the first
      compiler or linker error, else EasyBuild's own error line, with the
      line number and three lines either side. Logs rotate compressed are
      read as they are. Zig build only. RUN and the options come in any
      order.
      RUN
          A run directory, as a path or as a name under ROOT.
      --latest
          The newest run under ROOT, or the newest with a directory
          TARGET. The default when no RUN is given.
      --target TARGET, --target=TARGET
          Only the builds in the run's directory TARGET. Default: those in
          the run's own directory and in every directory in it.
      --root ROOT, --root=ROOT
          The directory that holds the runs. Default: the current
          directory.
      --json
          Print one line of JSON instead, with schema_version 1.
  eb-keep-logs -h | --help
      Print this help on stdout and exit 0.
  eb-keep-logs --version
      Print the version line on stdout and exit 0.

Environment:
  PATH                 Where failed looks up eb.
  EASYBUILD_TMPDIR     failed copies a command's output only from below it;
                       unset or empty, it copies none.
  EB_KEEP_LOGS_NOW     The time rotate takes as now, in seconds since the
                       epoch; unset or empty, the current time.
  EB_PIPELINE_LOG_DIR  rotate leaves alone the run that holds this path.
  TZ, TZDIR            The time zone of the local midnights, and the
                       directory of zone files.

Exit status:
  0   -h, --help or --version, or a failed, rotate or why that accepted
      its arguments, whatever it could keep, compress, remove or read:
      what it could not do is reported on stderr.
  2   The invocation was refused, with eb-keep-logs: MESSAGE on stderr; or
      no command was given, and this help is on stdout.
  75  rotate waited --lock-timeout seconds for the lock another rotate
      held, then gave up and changed nothing; run it again later.
EOF
}

die() { echo "eb-keep-logs: $*" >&2; exit 2; }

# A directory argument as paths join it to a name with "/": without trailing
# slashes, so "logs/" gives "logs/NAME" and "/" gives "/NAME".
_joinable() {
    local dir="$1"
    while [[ "${dir}" == */ ]]; do dir="${dir%/}"; done
    printf '%s\n' "${dir}"
}

# COUNT WORD: "1 WORD", else COUNT and WORD with an s.
_count() {
    if [ "$1" -eq 1 ]; then echo "$1 $2"; else echo "$1 $2s"; fi
}

# Record a kept file as one that may carry a licence number: a failed compile
# line of licensed software prints it. Once: a retried build keeps the same
# files again.
_list() {
    local path="$1" logdir="$2" abs
    abs=$(realpath "${path}")
    grep -qxF -- "${abs}" "${logdir}/.licensed-logs" 2>/dev/null ||
        echo "${abs}" >> "${logdir}/.licensed-logs"
}

_private() {
    local path="$1" logdir="$2"
    chmod o-rwx "${path}"
    _list "${path}" "${logdir}"
}

# The last command output a session log names, unless the lines after it
# record that command ending well: EasyBuild logs "... completed
# successfully" or "... FAILED (exit code N)" when a command ends, and
# nothing when the build died while it ran.
_failed_command_output() {
    local hit outcome
    hit=$(grep -noE '/[^[:space:]]*/run-shell-cmd-output/[^/[:space:]]+/out\.txt' "$1" | tail -n 1)
    [ -n "${hit}" ] || return 0
    outcome=$(tail -n +"$((${hit%%:*} + 1))" "$1" | grep -m 1 -oE ' FAILED \(exit code | completed successfully' | head -n 1)
    [ "${outcome}" = " completed successfully" ] || echo "${hit#*:}"
}

# Whether a meson testlog's summary shows every test passing: an "Ok:" line,
# and no "Fail:", "Unexpected Pass:" or "Timeout:" line counting more than 0.
_meson_passed() {
    grep -q '^Ok:' "$1" && ! grep -qE '^(Fail|Unexpected Pass|Timeout):[[:space:]]*[1-9]' "$1"
}

# The last line `eb --last-log` prints. EasyBuild 5.3 and later fold that path
# at the terminal width, 80 columns on a pipe, unless given
# --output-style=basic (EasyBuild 4.5 and later); an older eb refuses the
# option and does not fold, so it is asked again without it.
_last_log() {
    local line
    if line=$(eb --last-log "$@" --output-style=basic 2>/dev/null | tail -1) && [ -n "${line}" ]; then
        printf '%s\n' "${line}"
    else
        eb --last-log "$@" 2>/dev/null | tail -1
    fi
}

cmd_failed() {
    [ $# -ge 3 ] || die "failed needs STATUS NAME LOGDIR [TMP_LOGDIR]"
    local status="$1" name="$2" logdir="$3" explicit_logdir="${4:-}"
    local src dest
    [[ "${status}" =~ ^[0-9]+$ ]] || die "STATUS must be a number, not '${status}'"
    [ -d "${logdir}" ] || die "LOGDIR ${logdir} is not a directory"
    logdir=$(_joinable "${logdir}")
    if [ "${status}" -eq 0 ]; then
        return 0
    fi
    # The failed lines the kept copies hold are also in the build's own stdout
    # log and in the logs EasyBuild writes to TMP_LOGDIR. Close both to others,
    # TMP_LOGDIR with the regular files directly in it, not through a symbolic
    # link; TMP_LOGDIR only when it lies below LOGDIR, as the documented layout
    # puts it.
    local stdout_log="${logdir}/${name}.stdout.log" real_logdir real_tmp
    if [ -f "${stdout_log}" ] && [ ! -L "${stdout_log}" ]; then
        chmod o-rwx "${stdout_log}"
    fi
    if [ -n "${explicit_logdir}" ] && [ -d "${explicit_logdir}" ] && [ ! -L "${explicit_logdir}" ] &&
        real_logdir=$(realpath -e "${logdir:-/}") && real_tmp=$(realpath -e "${explicit_logdir}"); then
        case "${real_tmp}" in
            "${real_logdir%/}"/?*)
                chmod o-rwx "${explicit_logdir}"
                find "${explicit_logdir}" -mindepth 1 -maxdepth 1 -type f -exec chmod o-rwx {} +
                ;;
        esac
    fi
    if ! command -v eb >/dev/null 2>&1; then
        echo "No EasyBuild log to keep for ${name}: eb is not on PATH."
        return 0
    fi
    local rc=0
    if [ -n "${explicit_logdir}" ]; then
        src=$(_last_log --tmp-logdir="${explicit_logdir}") || rc=$?
    else
        src=$(_last_log) || rc=$?
    fi
    if [ "${rc}" -ne 0 ]; then
        echo "No EasyBuild log to keep for ${name}: eb --last-log exited ${rc}."
        return 0
    fi
    if [ -z "${src}" ] || [ ! -f "${src}" ]; then
        echo "No EasyBuild log to keep for ${name}."
        return 0
    fi
    # Without TMP_LOGDIR, `eb --last-log` names the newest log in EasyBuild's
    # default place, which can be a later build's. Nothing is taken from that
    # log; the build's own stdout log still names its failing command.
    local foreign=""
    if [ -z "${explicit_logdir}" ] && grep -q 'processing EasyBuild easyconfig ' "${src}" &&
        ! grep -qF -- "${name}.eb" "${src}"; then
        echo "No EasyBuild log to keep for ${name}: ${src} is another build's log."
        foreign=1
    else
        dest="${logdir}/${name}.failed.ebout.log"
        cp "${src}" "${dest}"
        _private "${dest}" "${logdir}"
        echo "Failed build log: ${dest}"
    fi

    # The failing command's own output holds the diagnostic beyond EasyBuild's
    # printed tail. Only the final command's text streams are kept, and from
    # the session log only when that command did not complete successfully;
    # only from inside EASYBUILD_TMPDIR and owned by the build account.
    local command_output command_root resolved_output stream
    command_output=""
    if [ -f "${logdir}/${name}.stdout.log" ]; then
        command_output=$(grep -oE '/[^[:space:]]*/run-shell-cmd-output/[^/[:space:]]+/out\.txt' "${logdir}/${name}.stdout.log" | tail -n 1)
    fi
    if [ -z "${command_output}" ] && [ -z "${foreign}" ]; then
        command_output=$(_failed_command_output "${src}")
    fi
    command_root="${command_output%/out.txt}"
    if [ -n "${command_output}" ] && [ -z "${EASYBUILD_TMPDIR:-}" ]; then
        echo "Failed command output not kept: EASYBUILD_TMPDIR is not set."
    elif [ -n "${command_output}" ]; then
        # EasyBuild names the streams through EASYBUILD_TMPDIR as it was
        # given, so both are compared resolved.
        local tmp_real stream_path
        tmp_real=$(realpath -e "${EASYBUILD_TMPDIR}" 2>/dev/null)
        for stream in out err; do
            stream_path="${command_root}/${stream}.txt"
            [ ! -L "${stream_path}" ] && [ -f "${stream_path}" ] || continue
            resolved_output=$(realpath -e "${stream_path}" 2>/dev/null) || continue
            if [ -z "${tmp_real}" ] || [[ "${resolved_output}" != "${tmp_real%/}/"* ]]; then
                echo "Failed command output not kept: ${stream_path} is not under EASYBUILD_TMPDIR."
                continue
            fi
            if [ "$(stat -c '%u' "${resolved_output}")" != "$(id -u)" ]; then
                echo "Failed command output not kept: ${stream_path} belongs to another user."
                continue
            fi
            dest="${logdir}/${name}.failed.command-${stream}.txt"
            cp "${resolved_output}" "${dest}" || continue
            chmod 600 "${dest}"
            _list "${dest}" "${logdir}"
            echo "Failed command output: ${dest}"
        done
    fi

    [ -z "${foreign}" ] || return 0
    # A meson test step prints only the last 100 lines of a failing test; the
    # full output is meson-logs/testlog.txt in the build directory. A testlog
    # whose tests all passed is not the failure.
    local meson_dir testlog
    meson_dir=$(tr '\n' ' ' < "${src}" | grep -oP 'meson test -C\s+\K[^[:space:]]+' | tail -n 1)
    testlog="${meson_dir}/meson-logs/testlog.txt"
    if [ -n "${meson_dir}" ] && [ -f "${testlog}" ] && ! _meson_passed "${testlog}"; then
        dest="${logdir}/${name}.failed.meson-testlog.txt"
        cp "${testlog}" "${dest}"
        _private "${dest}" "${logdir}"
        echo "Failed meson test log: ${dest}"
    fi
    return 0
}

# Days since a run directory's name, YYYYMMDD_HHMMSS; empty when the name is
# not a run directory. The name, not the mtime: compressing the run's logs
# moves the mtime of the directory they are in, where a chmod changes only
# the ctime.
_run_age_days() {
    local base date now start
    base=$(basename "$1")
    [[ "${base}" =~ ^([0-9]{8})_[0-9]{6}$ ]] || return 1
    date="${BASH_REMATCH[1]}"
    start=$(date -d "${date}" +%s 2>/dev/null) || return 1
    now=${EB_KEEP_LOGS_NOW:-$(date +%s)}
    echo $(( (now - start) / 86400 ))
}

# "/NAME" for each run directly under ROOT that this rotate writes into: the
# run holding its stdout or stderr when either is a file and, as srun passes
# the output on over a pipe, the run holding EB_PIPELINE_LOG_DIR, the log
# directory eb-pipeline exports. Such a run is still going.
_own_runs() {
    local root fd
    root=$(realpath -e -- "$1") || return 0
    root="${root%/}"
    for fd in 1 2; do
        [ -f "/proc/$$/fd/${fd}" ] && _run_of "${root}" "$(readlink -e -- "/proc/$$/fd/${fd}")"
    done
    [ -n "${EB_PIPELINE_LOG_DIR:-}" ] && _run_of "${root}" "$(readlink -e -- "${EB_PIPELINE_LOG_DIR}")"
    return 0
}

# "/NAME" when PATH lies in NAME directly under ROOT.
_run_of() {
    local rest
    case "$2" in
        "$1/"?*) rest="${2#"$1/"}"; printf '/%s' "${rest%%/*}" ;;
    esac
}

# "/NAME" for each run directly under ROOT that a process has a file in open
# for writing, of the processes whose descriptors this one may read in /proc:
# a build that is still going, whichever run it writes into. A link
# /proc/PID/fd/N has its owner's write bit when N is open for writing; for a
# file removed since, the link names the path it had, with " (deleted)" added.
_written_runs() {
    local root target
    root=$(realpath -e -- "$1") || return 0
    root="${root%/}"
    while IFS= read -r -d '' target; do
        _run_of "${root}" "${target}"
    done < <(find /proc/[0-9]*/fd -mindepth 1 -maxdepth 1 -type l -perm -u=w -printf '%l\0' 2>/dev/null)
    return 0
}

# Hold an exclusive flock on the lock file LOCK until this rotate exits,
# waiting up to SECONDS for another holder; exit 75 when it does not let go.
# Opened for reading when it cannot be opened for writing, by a user who may
# not write ROOT. On a file system that cannot lock, rotate without it.
_lock_rotate() {
    local lock="$1" seconds="$2" fd rc=0
    if [ -L "${lock}" ] || { [ -e "${lock}" ] && [ ! -f "${lock}" ]; }; then
        die "cannot lock ${lock}"
    fi
    { exec {fd}>>"${lock}"; } 2>/dev/null || { exec {fd}<"${lock}"; } 2>/dev/null || die "cannot lock ${lock}"
    flock -w "${seconds}" -E 75 "${fd}" || rc=$?
    case "${rc}" in
        0) ;;
        75) echo "eb-keep-logs: another rotate holds the lock ${lock}; gave up after ${seconds} s (--lock-timeout)" >&2
            exit 75 ;;
        *) echo "eb-keep-logs: cannot lock ${lock}; rotating without the lock" >&2 ;;
    esac
}

cmd_rotate() {
    local root="" compress_after="" delete_after="" lock_timeout=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --compress-after) compress_after="${2:-}"; shift 2 ;;
            --compress-after=*) compress_after="${1#*=}"; shift ;;
            --delete-after) delete_after="${2:-}"; shift 2 ;;
            --delete-after=*) delete_after="${1#*=}"; shift ;;
            --lock-timeout)
                [ $# -ge 2 ] || die "--lock-timeout needs a number of seconds"
                lock_timeout="$2"; shift 2 ;;
            --lock-timeout=*) lock_timeout="${1#*=}"; shift ;;
            -*) die "unknown option $1" ;;
            *) [ -z "${root}" ] || die "rotate takes one ROOT"; root="$1"; shift ;;
        esac
    done
    [ -n "${root}" ] || die "rotate needs ROOT"
    [ -d "${root}" ] || die "ROOT ${root} is not a directory"
    [[ "${compress_after}" =~ ^[0-9]+$ ]] || die "--compress-after needs a number of days"
    if [ -n "${delete_after}" ]; then
        [[ "${delete_after}" =~ ^[0-9]+$ ]] || die "--delete-after needs a number of days"
        [ "${delete_after}" -gt "${compress_after}" ] || die "--delete-after must be later than --compress-after"
    fi
    if [ -n "${lock_timeout}" ]; then
        [[ "${lock_timeout}" =~ ^[0-9]+$ ]] || die "--lock-timeout needs a number of seconds"
        lock_timeout="${lock_timeout#"${lock_timeout%%[!0]*}"}"
        lock_timeout="${lock_timeout:-0}"
        # flock(1) cannot set a timer for 10^19 seconds; this is 31 years.
        [ "${#lock_timeout}" -le 9 ] || lock_timeout=999999999
    else
        lock_timeout=600
    fi
    _lock_rotate "$(_joinable "${root}")/.eb-keep-logs-rotate.lock" "${lock_timeout}"
    local run age file list tmp path compressed=0 deleted=0 live
    live="$(_own_runs "${root}")$(_written_runs "${root}")/"
    for run in "$(_joinable "${root}")"/*/; do
        run="${run%/}"
        [ -d "${run}" ] && [ ! -L "${run}" ] || continue
        age=$(_run_age_days "${run}") || continue
        # A later rotate takes a run that is still written into, by this
        # rotate or by a build that is still going.
        case "${live}" in *"/${run##*/}/"*) continue ;; esac
        if [ -n "${delete_after}" ] && [ "${age}" -ge "${delete_after}" ]; then
            rm -rf -- "${run}"
            deleted=$((deleted + 1))
            continue
        fi
        [ "${age}" -ge "${compress_after}" ] || continue
        while IFS= read -r -d '' file; do
            path="$(realpath "${file%/*}")/${file##*/}"
            # gzip keeps the file's mode, so a closed log stays closed.
            gzip -9 -- "${file}" || continue
            compressed=$((compressed + 1))
            # A .licensed-logs in the run names the file by path; follow it.
            # The new list is written beside the old one, under a name of its
            # own, and renamed over it, so a reader sees one list or the other.
            while IFS= read -r -d '' list; do
                tmp=$(mktemp -- "${list%/*}/.licensed-logs.XXXXXXXX") || continue
                { awk -v p="${path}" '$0 == p { $0 = p ".gz" } { print }' "${list}" > "${tmp}" &&
                    chmod --reference="${list}" -- "${tmp}" && mv -f -- "${tmp}" "${list}"; } ||
                    rm -f -- "${tmp}"
            done < <(find "${run}" -name .licensed-logs -type f -print0)
        done < <(find "${run}" -type f \( -name '*.log' -o -name '*.txt' \) -print0)
    done
    echo "eb-keep-logs rotate: $(_count "${compressed}" file) compressed, $(_count "${deleted}" run) deleted under ${root}"
}

case "${1:-}" in
    -h|--help) usage ;;
    --version) echo "eb-keep-logs ${VERSION}" ;;
    failed) shift; cmd_failed "$@" ;;
    rotate) shift; cmd_rotate "$@" ;;
    why) die "why is in the Zig build only" ;;
    "") usage; exit 2 ;;
    *) die "unknown command '$1' (failed, rotate, why, --help)" ;;
esac
