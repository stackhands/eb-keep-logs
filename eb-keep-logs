#!/bin/bash
# eb-keep-logs: keep the logs of EasyBuild builds that a build pipeline would
# otherwise lose, and keep the pipeline's log tree bounded.
#
# A failed build's log is in EasyBuild's tmpdir on the build node, which goes
# with the job; and EasyBuild wraps the "Results of the build can be found in
# the log file(s)" line, so parsing stdout for the path finds nothing.
# `eb --last-log` gives the path, on one line with the basic output style.
set -uo pipefail

VERSION=0.1.0

# src/main.zig's usage_text holds the same text: tests/differential.sh
# compares the two.
usage() {
    cat <<'EOF'
eb-keep-logs: keep the logs of EasyBuild builds that a build pipeline would
otherwise lose, and keep the pipeline's log tree bounded.

  eb-keep-logs failed [--syslog TARGET] [--metrics-file PATH] STATUS NAME LOGDIR [TMP_LOGDIR]
      After `eb` returned STATUS for easyconfig NAME: when STATUS is not 0,
      copy the EasyBuild session log `eb --last-log` names, the failing
      command's output and a meson testlog next to LOGDIR/NAME.stdout.log,
      closed to others and listed in LOGDIR/.licensed-logs. TMP_LOGDIR is
      the --tmp-logdir eb ran with; without it, the newest log in
      EasyBuild's default place is used, unless it is another build's.
      NAME.stdout.log and a TMP_LOGDIR below LOGDIR are closed to others too.
      --syslog TARGET, --syslog=TARGET
          Emit an RFC 5424 or native systemd-journald event when logs are
          kept or none are found. Default: EB_KEEP_LOGS_SYSLOG, else none.
      --metrics-file PATH, --metrics-file=PATH
          Atomically update Prometheus counters for kept logs and bytes.
          Default: none.
  eb-keep-logs rotate ROOT --compress-after DAYS [--delete-after DAYS]
                           [--dry-run] [--lock-timeout SECONDS]
                           [--syslog TARGET] [--metrics-file PATH]
      In the run directories directly under ROOT (named YYYYMMDD_HHMMSS),
      gzip the *.log and *.txt files of old runs and remove older runs
      whole, leaving alone a run that is still written into. A run's age is
      in days from the local midnight of the date in its name. Permissions
      and .licensed-logs follow. One rotate of ROOT runs at a time, holding
      ROOT/.eb-keep-logs-rotate.lock. Options and ROOT come in any order.
      --compress-after DAYS, --compress-after=DAYS
          Gzip the files of runs at least DAYS old. Required; there is no
          default.
      --delete-after DAYS, --delete-after=DAYS
          Remove whole runs at least DAYS old; DAYS must be larger than
          that of --compress-after. Default: none; no run is removed. An
          empty value is the default.
      --dry-run
          Print each file that would be compressed and run that would be
          deleted, but change nothing, create no lock, emit no event and
          write no metrics.
      --lock-timeout SECONDS, --lock-timeout=SECONDS
          While another rotate holds the lock, wait up to SECONDS for it,
          then give up and exit 75. Default: 600; 0 does not wait. An empty
          value is the default.
      --syslog TARGET, --syslog=TARGET
          Emit an RFC 5424 or native systemd-journald event with the
          compressed and deleted counts. Default: EB_KEEP_LOGS_SYSLOG,
          else none.
      --metrics-file PATH, --metrics-file=PATH
          Atomically record when this rotation completed, unless --dry-run
          is given. Default: none.
  eb-keep-logs why [RUN | --latest] [--target TARGET] [--package PACKAGE]
                   [--since DATE] [--until DATE] [--root ROOT] [--json]
      Say why the builds of a run failed: for each failed easyconfig, its
      package and easyconfig, the EasyBuild step it failed in, EasyBuild's
      message, and the line of its kept log that shows the error: the first
      compiler or linker error, else EasyBuild's own error line, with the
      line number and three lines either side. Logs rotate compressed are
      read as they are. Zig build only. RUN and the options come in any
      order.
      RUN
          A run directory, as a path or as a name under ROOT.
      --latest
          The newest run under ROOT, or the newest with a directory
          TARGET. The default when no RUN is given.
      --target TARGET, --target=TARGET
          Only the builds in the run's directory TARGET. Default: those in
          the run's own directory and in every directory in it.
      --package PACKAGE, --package=PACKAGE
          Only builds matching PACKAGE (an easyconfig name without .eb,
          a prefix up to a dash, or NAME/VERSION). Default: all builds.
      --since DATE, --since=DATE
          Only consider runs at or after DATE when picking --latest.
          DATE is YYYY-MM-DD, YYYYMMDD, or YYYYMMDD_HHMMSS.
          Default: none.
      --until DATE, --until=DATE
          Only consider runs at or before DATE when picking --latest.
          DATE is YYYY-MM-DD, YYYYMMDD, or YYYYMMDD_HHMMSS.
          Default: none.
      --root ROOT, --root=ROOT
          The directory that holds the runs. Default: the current
          directory.
      --json
          Print one line of JSON instead, with schema_version 1.
  eb-keep-logs history PACKAGE [--target TARGET] [--since DATE]
                       [--until DATE] [--failed] [--root ROOT] [--json]
      Say how each kept build of PACKAGE went, oldest run first: success,
      failed or unknown, and how long EasyBuild took, from its output.
      PACKAGE is an easyconfig's name or its start up to a dash, as hello
      or hello-2.12.1 for hello-2.12.1-GCCcore-14.2.0, or a module name, as
      hello/2.12.1; hello also takes hello-world-1.0. Zig build only.
      PACKAGE and the options come in any order.
      --target TARGET, --target=TARGET
          Only the builds in each run's directory TARGET. Default: those in
          each run's own directory and in every directory in it.
      --since DATE, --since=DATE
          Only read runs at or after DATE (YYYY-MM-DD, YYYYMMDD, or
          YYYYMMDD_HHMMSS). Default: none.
      --until DATE, --until=DATE
          Only read runs at or before DATE (YYYY-MM-DD, YYYYMMDD, or
          YYYYMMDD_HHMMSS). Default: none.
      --failed
          Only list failed builds.
      --root ROOT, --root=ROOT
          The directory that holds the runs. Default: the current
          directory.
      --json
          Print one line of JSON instead, with schema_version 1.
  eb-keep-logs failures [--package PACKAGE] [--target TARGET]
                        [--since DATE] [--until DATE] [--root ROOT] [--json]
      List failed builds across runs under --root, oldest run first.
      Each row gives the run, target, failed step, duration and build
      name. Zig build only. Options come in any order.
      --package PACKAGE, --package=PACKAGE
          Only failed builds matching PACKAGE (an easyconfig name
          without .eb, a prefix up to a dash, or NAME/VERSION). Default:
          all packages.
      --target TARGET, --target=TARGET
          Only the builds in each run's directory TARGET. Default: those
          in each run's own directory and in every directory in it.
      --since DATE, --since=DATE
          Only read runs at or after DATE (YYYY-MM-DD, YYYYMMDD, or
          YYYYMMDD_HHMMSS). Default: none.
      --until DATE, --until=DATE
          Only read runs at or before DATE (YYYY-MM-DD, YYYYMMDD, or
          YYYYMMDD_HHMMSS). Default: none.
      --root ROOT, --root=ROOT
          The directory that holds the runs. Default: the current
          directory.
      --json
          Print one line of JSON instead, with schema_version 1.
  eb-keep-logs loads --module NAME [--json] FILE
      Print who loaded NAME, from Lmod's ModuleUsageTracking lines in FILE.
      Each record is user=USER module=NAME path=PATH host=HOST time=TIME,
      in any order, and a syslog prefix is left in place. Each load is
      one line, user=USER host=HOST time=TIME path=PATH, in the file's
      order. A file with no load of NAME prints no load of NAME. Zig
      build only.
      --module NAME, --module=NAME
          The module's full name, as Lmod recorded it, such as
          GROMACS/2024.1. Required.
      --json
          Print one line of JSON instead, with schema_version 1.
      FILE
          The log that holds the records. A line that is not one is
          skipped.
  eb-keep-logs used --prefix PREFIX [--json] [--require-none] FILE...
      Print paths under PREFIX that appear in XALT or Lmod records in
      FILE. A run record lists userT.exec_path (kind run) and each libA
      path under PREFIX (kind run-lib) even when exec_path is outside.
      A link record lists resultT.exec_path and each linkA path (kind
      link). A package record lists package_path (kind pkg). An Lmod
      tracking line lists path when it is under PREFIX (kind module-load).
      Each line is path=PATH kind=KIND last=TIME count=N; last is the
      newest time seen for that path. With no hit, nothing under PREFIX.
      --json prints one JSON document with schema_version 1. --require-none
      exits 2 when any hit is listed. Zig build only.
      --prefix PREFIX, --prefix=PREFIX
          The install tree to check. Required; a newline in it is refused.
      --json
          Print one line of JSON instead.
      --require-none
          Exit 2 when any path under PREFIX was found.
      FILE
          One or more files of concatenated XALT JSON objects and/or Lmod
          ModuleUsageTracking lines. Required.
  eb-keep-logs usage --software DIR --modules DIR [--since EPOCH]
                     [--unused | --active] [--json] FILE...
      Compare installed DIR/Name/Version software with XALT and Lmod
      records. XALT paths below the software directory and Lmod module
      loads below the modules directory count as hits. By default, print
      every installed Name/Version with its state, hit count and newest
      time. --unused and --active print only Name/Version lines;
      --active output is accepted by eb-stack stack gap --site. --since
      ignores records older than EPOCH and records without a time.
      --json prints one JSON document with schema_version 1. Zig build
      only.
      --software DIR, --software=DIR
          The software install tree, with Name/Version directories.
          Required.
      --modules DIR, --modules=DIR
          The module tree that Lmod record paths must be below. Required.
      --since EPOCH, --since=EPOCH
          Count records at or after this non-negative epoch time.
          Default: all record times.
      --unused
          List installed Name/Version entries with no hit.
      --active
          List installed Name/Version entries with at least one hit.
      --json
          Print one line of JSON instead.
      FILE
          One or more files of concatenated XALT JSON objects and/or Lmod
          ModuleUsageTracking lines. Required.
  eb-keep-logs runs --exec PATH [--json] FILE
      Print who ran PATH, from XALT run records in FILE. A run record is a
      JSON object whose userT holds user, exec_path and, when present,
      syshost and start_time. A link record is not a run and is skipped.
      PATH matches exec_path in full or as its last component. Each run is
      one line, user=USER host=HOST time=TIME path=PATH, in the file's
      order. A file with no run of PATH prints no run of PATH. Zig build
      only. It does not record runs.
      --exec PATH, --exec=PATH
          The executable, as a full path or its last component. Required.
      --json
          Print one line of JSON instead, with schema_version 1.
      FILE
          One or more JSON objects. An object that is not a run record is
          skipped.
  eb-keep-logs pending [--json] FILE
      Print what an EasyBuild dry-run or missing-modules report still has
      to build. A dry-run line is "* [ ] PATH (module: NAME)", and [F] and
      [R] count as still to build; [x] is already installed and is not
      printed. --terse prints "x PATH" or "- PATH". A missing-modules line
      is "* NAME (FILE.eb)", or with --terse one easyconfig path on each
      line. Each is one line, build NAME or missing NAME, in the file's
      order. A report with nothing left prints nothing to build. Zig build
      only. It does not run eb, and it does not resolve dependencies.
      --json
          Print one line of JSON instead, with schema_version 1.
      FILE
          The report, as eb --dry-run or eb --missing-modules printed it.
          Required.
  eb-keep-logs test-bundle --test-id ID --suite-revision REV --eessi-target TARGET
                           ... --stdout FILE --stderr FILE [--input FILE ...]
                           ... [--module NAME=PATH ...] --seed SEED
                           ... --allocation TEXT --binding TEXT --cpu TEXT --gpu TEXT
                           [--out FILE]
      Write one flaky-test evidence bundle as JSON schema_version 1, with a
      stable test identity (ID), normalized stdout and stderr, input and
      seed hashes, full module list and module paths, EESSI target,
      scheduler allocation and binding, CPU and GPU facts, and test-suite
      revision. Without --out, print it on stdout. Zig build only.
      --test-id ID, --test-id=ID
          Stable test identity. Required.
      --suite-revision REV, --suite-revision=REV
          Test-suite revision. Required.
      --eessi-target TARGET, --eessi-target=TARGET
          EESSI target of the run. Required.
      --stdout FILE, --stdout=FILE
          Captured stdout, normalized and hashed. Required.
      --stderr FILE, --stderr=FILE
          Captured stderr, normalized and hashed. Required.
      --input FILE, --input=FILE
          Input file to hash. Optional; may be repeated. Default: none.
      --module NAME=PATH, --module=NAME=PATH
          Loaded module and its modulefile path. Optional; may be
          repeated. Default: none.
      --seed SEED, --seed=SEED
          Seed value to hash. Required.
      --allocation TEXT, --allocation=TEXT
          Scheduler allocation summary. Required.
      --binding TEXT, --binding=TEXT
          Scheduler binding summary. Required.
      --cpu TEXT, --cpu=TEXT
          CPU facts. Required.
      --gpu TEXT, --gpu=TEXT
          GPU facts, or none. Required.
      --out FILE, --out=FILE
          Write JSON to FILE. Default: stdout.
  eb-keep-logs test-compare [--json] BUNDLE...
      Summarize which evidence fields differ across two or more
      test-bundle JSON files, without deciding pass or fail. --json prints
      schema_version 1. Zig build only.
      --json
          Print one line of JSON instead of text. Default: text.
      BUNDLE
          Two or more test-bundle JSON files. Required.
  eb-keep-logs lifecycle --policy FILE [--modulerc-out FILE]
                         [--easyconfigs DIR ...] [--easystack FILE ...]
                         [--eb-stack PATH] [--rebuild-set FILE]
                         [--now EPOCH] [--json] FILE
      Generate a reversible lifecycle plan and Lmod .modulerc.lua
      warnings/forbids from usage --json output and a TOML policy. Never
      deletes software or modulefiles. Requires a minimum observation
      window and checks installed dependents via eb-stack rebuild-set
      before allowing candidate-remove. Zig build only.
      --policy FILE, --policy=FILE
          TOML lifecycle policy file. Required.
      --modulerc-out FILE, --modulerc-out=FILE
          Write the generated Lmod .modulerc.lua warnings and forbids
          durably to FILE. Default: none; no file is written.
      --easyconfigs DIR, --easyconfigs=DIR
          Easyconfig tree passed to eb-stack rebuild-set to identify
          dependents of candidate removals. Repeatable. Default: none.
      --easystack FILE, --easystack=FILE
          Deployed easystack YAML passed to eb-stack rebuild-set.
          Repeatable. Default: none.
      --eb-stack PATH, --eb-stack=PATH
          Path to the eb-stack executable. Default: eb-stack on PATH.
      --rebuild-set FILE, --rebuild-set=FILE
          Precomputed eb-stack rebuild-set.json report instead of
          running eb-stack. Default: none.
      --now EPOCH, --now=EPOCH
          Reference epoch time in seconds for idle age and observation
          window checks. Default: the environment time override, else
          the current time.
      --json
          Print one line of JSON instead, with schema_version 1.
      FILE
          JSON output produced by eb-keep-logs usage --json (with
          selection "all"). Required.
  eb-keep-logs -h | --help
      Print this help on stdout and exit 0.
  eb-keep-logs --version
      Print the version line on stdout and exit 0.

Environment:
  PATH                 Where failed looks up eb.
  EASYBUILD_TMPDIR     failed copies a command's output only from below it;
                       unset or empty, it copies none.
  EB_KEEP_LOGS_NOW     The time rotate and lifecycle take as now, in seconds
                       since the epoch; unset or empty, the current time.
  EB_PIPELINE_LOG_DIR  rotate leaves alone the run that holds this path.
  EB_KEEP_LOGS_SYSLOG  Default --syslog target (journald, syslog, unix:///...,
                       journal+unix:///..., udp://host:port, tcp://host:port).
  EB_KEEP_LOGS_SYSLOG_PEN
                       IANA Private Enterprise Number for RFC 5424 SD-ID
                       ebKeepLogs@<PEN>. Default: 32473 (RFC 5398 placeholder).
  TZ, TZDIR            The time zone of the local midnights, and the
                       directory of zone files.

Exit status:
  0   -h, --help or --version, or a failed, rotate, why, history, failures, loads, runs, used, usage, pending, test-bundle, test-compare or lifecycle that
      accepted its arguments, whatever it could keep, compress, remove or
      read: what it could not do is reported on stderr. used with
      --require-none also exits 2 when any path was listed.
  2   The invocation was refused, with eb-keep-logs: MESSAGE on stderr; or
      no command was given, and this help is on stdout.
  75  rotate waited --lock-timeout seconds for the lock another rotate
      held, then gave up and changed nothing; run it again later.
EOF
}

die() { echo "eb-keep-logs: $*" >&2; exit 2; }

# A directory argument as paths join it to a name with "/": without trailing
# slashes, so "logs/" gives "logs/NAME" and "/" gives "/NAME".
_joinable() {
    local dir="$1"
    while [[ "${dir}" == */ ]]; do dir="${dir%/}"; done
    printf '%s\n' "${dir}"
}

# COUNT WORD: "1 WORD", else COUNT and WORD with an s.
_count() {
    if [ "$1" -eq 1 ]; then echo "$1 $2"; else echo "$1 $2s"; fi
}

# Record a kept file as one that may carry a licence number: a failed compile
# line of licensed software prints it. Once: a retried build keeps the same
# files again.
_list() {
    local path="$1" logdir="$2" abs
    abs=$(realpath "${path}")
    grep -qxF -- "${abs}" "${logdir}/.licensed-logs" 2>/dev/null ||
        echo "${abs}" >> "${logdir}/.licensed-logs"
}

_private() {
    local path="$1" logdir="$2"
    chmod o-rwx "${path}"
    _list "${path}" "${logdir}"
}

# The last command output a session log names, unless the lines after it
# record that command ending well: EasyBuild logs "... completed
# successfully" or "... FAILED (exit code N)" when a command ends, and
# nothing when the build died while it ran.
_failed_command_output() {
    local hit outcome
    hit=$(grep -noE '/[^[:space:]]*/run-shell-cmd-output/[^/[:space:]]+/out\.txt' "$1" | tail -n 1)
    [ -n "${hit}" ] || return 0
    outcome=$(tail -n +"$((${hit%%:*} + 1))" "$1" | grep -m 1 -oE ' FAILED \(exit code | completed successfully' | head -n 1)
    [ "${outcome}" = " completed successfully" ] || echo "${hit#*:}"
}

# Whether a meson testlog's summary shows every test passing: an "Ok:" line,
# and no "Fail:", "Unexpected Pass:" or "Timeout:" line counting more than 0.
_meson_passed() {
    grep -q '^Ok:' "$1" && ! grep -qE '^(Fail|Unexpected Pass|Timeout):[[:space:]]*[1-9]' "$1"
}

# The last line `eb --last-log` prints. EasyBuild 5.3 and later fold that path
# at the terminal width, 80 columns on a pipe, unless given
# --output-style=basic (EasyBuild 4.5 and later); an older eb refuses the
# option and does not fold, so it is asked again without it.
_last_log() {
    local line
    if line=$(eb --last-log "$@" --output-style=basic 2>/dev/null | tail -1) && [ -n "${line}" ]; then
        printf '%s\n' "${line}"
    else
        eb --last-log "$@" 2>/dev/null | tail -1
    fi
}

_resolve_syslog_pen() {
    local raw="${EB_KEEP_LOGS_SYSLOG_PEN:-}"
    SYSLOG_PEN="32473"
    [ -n "${raw}" ] || return 0
    local s="${raw#"${raw%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    [[ -n "${s}" && "${#s}" -le 20 && "${s}" =~ ^[0-9]+$ ]] ||
        die "EB_KEEP_LOGS_SYSLOG_PEN must be a positive integer, not '${raw}'"
    local trimmed="${s#"${s%%[!0]*}"}"
    [ -n "${trimmed}" ] ||
        die "EB_KEEP_LOGS_SYSLOG_PEN must be a positive integer, not '${raw}'"
    if [ "${#trimmed}" -eq 20 ]; then
        local hi="${trimmed:0:10}" lo="${trimmed:10:10}"
        lo="1${lo}"
        if [ "${hi}" -gt 1844674407 ] || { [ "${hi}" -eq 1844674407 ] && [ "${lo}" -gt 13709551615 ]; }; then
            die "EB_KEEP_LOGS_SYSLOG_PEN must be a positive integer, not '${raw}'"
        fi
    fi
    SYSLOG_PEN="${trimmed}"
}

_resolve_syslog() {
    local raw="${1}"
    SYSLOG_TARGET=""
    [ -n "${raw}" ] || return 0
    case "${raw}" in
        *$'\n'*|*$'\r'*) die "invalid syslog target '${raw}'" ;;
        syslog|journald|journal|/*|unix:///*|journal+unix:///*) ;;
        udp://*:*|tcp://*:*)
            local hp port host
            hp="${raw#*://}"
            port="${hp##*:}"
            host="${hp%:*}"
            [[ -n "${host}" && "${port}" =~ ^[0-9]+$ && "${port}" -ge 1 && "${port}" -le 65535 ]] ||
                die "invalid syslog target '${raw}'"
            ;;
        *) die "invalid syslog target '${raw}'" ;;
    esac
    SYSLOG_TARGET="${raw}"
}

_emit_syslog() {
    local target="$1" sev="$2" msgid="$3" msg="$4"
    shift 4
    [ -n "${target}" ] || return 0
    local py=""
    if command -v python3 >/dev/null 2>&1; then
        py=$(command -v python3)
    elif [ -x /usr/bin/python3 ]; then
        py=/usr/bin/python3
    fi
    if [ -n "${py}" ]; then
        if ! "${py}" - "$target" "${SYSLOG_PEN:-32473}" "$sev" "$msgid" "$msg" "$$" "$@" <<'PY'
import datetime, os, socket, sys

target, pen, sev_s, msgid, msg, pid = sys.argv[1:7]
pairs = [kv.split("=", 1) for kv in sys.argv[7:] if "=" in kv]

def one_line(s, limit=500):
    return "".join(" " if ord(c) < 32 or ord(c) == 127 else c for c in s)[:limit]

def sd_esc(v):
    return one_line(v, 256).replace("\\", "\\\\").replace('"', '\\"').replace("]", "\\]")

def send_unix(path, payload, stream_nl):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.settimeout(0.5)
            s.connect(path)
            s.sendall(payload)
            return True
    except OSError:
        if not stream_nl:
            return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(path)
            s.sendall(payload + b"\n")
            return True
    except OSError:
        return False

if target in ("journald", "journal"):
    scheme, hp, port = "journal", "/run/systemd/journal/socket", 0
elif target == "syslog":
    scheme, hp, port = "unix", "/dev/log", 0
elif target.startswith("/"):
    scheme, hp, port = "unix", target, 0
elif target.startswith("unix://"):
    scheme, hp, port = "unix", target[7:], 0
elif target.startswith("journal+unix://"):
    scheme, hp, port = "journal", target[15:], 0
elif target.startswith("udp://"):
    h, p = target[6:].rsplit(":", 1)
    if h.startswith("[") and h.endswith("]"):
        h = h[1:-1]
    scheme, hp, port = "udp", h, int(p)
else:
    h, p = target[6:].rsplit(":", 1)
    if h.startswith("[") and h.endswith("]"):
        h = h[1:-1]
    scheme, hp, port = "tcp", h, int(p)

if scheme == "journal":
    entries = [
        ("MESSAGE", one_line(msg)),
        ("PRIORITY", sev_s),
        ("SYSLOG_IDENTIFIER", "eb-keep-logs"),
        ("SYSLOG_FACILITY", "1"),
        ("MSGID", msgid),
    ]
    for k, v in pairs:
        if k.startswith("J:") and v:
            entries.append((k[2:], one_line(v)))
    payload = b"".join(
        f"{k}={v}\n".encode("utf-8", "replace")
        for k, v in entries
    )
    ok = send_unix(hp, payload, False)
else:
    pri = 8 + int(sev_s)
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    host = "".join(c for c in socket.gethostname() if 33 <= ord(c) <= 126)[:255] or "-"
    sd = " ".join(f'{k[2:]}="{sd_esc(v)}"' for k, v in pairs if k.startswith("P:"))
    line = f"<{pri}>1 {ts} {host} eb-keep-logs {pid} {msgid} [ebKeepLogs@{pen} {sd}] {one_line(msg)}"
    payload = line.encode("utf-8", "replace")
    if scheme == "unix":
        ok = send_unix(hp, payload, True)
    elif scheme == "udp":
        ok = False
        for fam, _, _, _, sa in socket.getaddrinfo(hp, port, 0, socket.SOCK_DGRAM):
            try:
                with socket.socket(fam, socket.SOCK_DGRAM) as s:
                    s.settimeout(0.5)
                    s.sendto(payload, sa)
                ok = True
                break
            except OSError:
                continue
    else:
        frame = f"{len(payload)} ".encode("ascii") + payload
        try:
            with socket.create_connection((hp, port), timeout=0.5) as s:
                s.sendall(frame)
            ok = True
        except OSError:
            ok = False
sys.exit(0 if ok else 1)
PY
        then
            echo "eb-keep-logs: cannot emit syslog event" >&2
        fi
    fi
}

_emit_failed_syslog() {
    local target="$1" status="$2" name="$3" logdir_s="$4" ebout="$5" cmd_kept="$6" meson="$7" reason="$8"
    [ -n "${target}" ] || return 0
    local kept=$((ebout + cmd_kept + meson))
    local licensed="${kept}"
    local cmdout=0; [ "${cmd_kept}" -gt 0 ] && cmdout=1
    local msgid="EB_KEEP_NONE"
    [ "${kept}" -gt 0 ] && msgid="EB_KEEP_FAILED"
    local msg
    if [ "${kept}" -gt 0 ]; then
        msg="eb-keep-logs failed: kept $(_count "${kept}" file) for ${name} (status ${status})"
    else
        msg="eb-keep-logs failed: no EasyBuild log kept for ${name} (${reason})"
    fi
    local extra=()
    [ -n "${SLURM_JOB_ID:-}" ] && extra+=("P:job=${SLURM_JOB_ID}" "J:SLURM_JOB_ID=${SLURM_JOB_ID}")
    [ -n "${SLURM_STEP_ID:-}" ] && extra+=("P:step=${SLURM_STEP_ID}" "J:SLURM_STEP_ID=${SLURM_STEP_ID}")
    _emit_syslog "${target}" 4 "${msgid}" "${msg}" \
        "P:cmd=failed" "P:status=${status}" "P:name=${name}" "P:logdir=${logdir_s}" \
        "P:kept=${kept}" "P:licensed=${licensed}" "P:ebout=${ebout}" \
        "P:cmdout=${cmdout}" "P:meson=${meson}" "P:reason=${reason}" \
        "J:EB_KEEP_CMD=failed" "J:EB_KEEP_STATUS=${status}" "J:EB_KEEP_NAME=${name}" \
        "J:EB_KEEP_LOGDIR=${logdir_s}" "J:EB_KEEP_KEPT=${kept}" "J:EB_KEEP_LICENSED=${licensed}" \
        "J:EB_KEEP_EBOUT=${ebout}" "J:EB_KEEP_CMDOUT=${cmdout}" "J:EB_KEEP_MESON=${meson}" \
        "J:EB_KEEP_REASON=${reason}" "${extra[@]}"
}

# Add two unsigned decimal integers without using Bash's signed arithmetic.
# Refuse a result beyond the u64 range used by the Zig implementation.
_add_u64() {
    local a="$1" b="$2" out="" carry=0 da db sum
    local i j max=18446744073709551615
    a="${a#"${a%%[!0]*}"}"; a="${a:-0}"
    b="${b#"${b%%[!0]*}"}"; b="${b:-0}"
    i=${#a}; j=${#b}
    while [ "${i}" -gt 0 ] || [ "${j}" -gt 0 ] || [ "${carry}" -gt 0 ]; do
        da=0
        db=0
        if [ "${i}" -gt 0 ]; then i=$((i - 1)); da="${a:i:1}"; fi
        if [ "${j}" -gt 0 ]; then j=$((j - 1)); db="${b:j:1}"; fi
        sum=$((da + db + carry))
        out="$((sum % 10))${out}"
        carry=$((sum / 10))
    done
    # Decimal strings of equal length are ordered lexically.
    # shellcheck disable=SC2071
    if [ "${#out}" -gt "${#max}" ] ||
        { [ "${#out}" -eq "${#max}" ] && [[ "${out}" > "${max}" ]]; }; then
        return 1
    fi
    printf '%s\n' "${out}"
}

_u64_gt() {
    local a="$1" b="$2"
    a="${a#"${a%%[!0]*}"}"; a="${a:-0}"
    b="${b#"${b%%[!0]*}"}"; b="${b:-0}"
    [ "${#a}" -gt "${#b}" ] && return 0
    [ "${#a}" -lt "${#b}" ] && return 1
    # Decimal strings of equal length are ordered lexically.
    # shellcheck disable=SC2071
    [[ "${a}" > "${b}" ]]
}

_update_metrics() {
    local file="$1" add_logs="$2" add_bytes="$3" prune="$4"
    [ -n "${file}" ] || return 0
    local dir base lock fd tmp logs=0 bytes=0 last=0 value new_logs new_bytes
    dir="${file%/*}"; [ "${dir}" != "${file}" ] || dir=.
    base="${file##*/}"
    if [ -z "${base}" ] || [ ! -d "${dir}" ]; then
        echo "eb-keep-logs: cannot update metrics file ${file}: invalid path" >&2
        return 0
    fi
    lock="${dir}/.${base}.lock"
    if [ -L "${lock}" ] || { [ -e "${lock}" ] && [ ! -f "${lock}" ]; } ||
        ! { exec {fd}>>"${lock}"; } 2>/dev/null || ! flock "${fd}"; then
        echo "eb-keep-logs: cannot update metrics file ${file}: cannot lock it" >&2
        return 0
    fi
    if [ -e "${file}" ]; then
        if [ ! -f "${file}" ] || [ -L "${file}" ]; then
            echo "eb-keep-logs: cannot update metrics file ${file}: not a regular file" >&2
            exec {fd}>&-
            return 0
        fi
        value=$(awk '$1 == "eb_keep_logs_logs_kept_total" { if (++n > 1 || $2 !~ /^[0-9]+$/) exit 2; v=$2 } END { if (n) print v }' "${file}")
        if [ "$?" -ne 0 ]; then
            echo "eb-keep-logs: cannot update metrics file ${file}: invalid metrics" >&2
            exec {fd}>&-
            return 0
        fi
        logs=${value:-0}
        value=$(awk '$1 == "eb_keep_logs_bytes_kept_total" { if (++n > 1 || $2 !~ /^[0-9]+$/) exit 2; v=$2 } END { if (n) print v }' "${file}")
        if [ "$?" -ne 0 ]; then
            echo "eb-keep-logs: cannot update metrics file ${file}: invalid metrics" >&2
            exec {fd}>&-
            return 0
        fi
        bytes=${value:-0}
        value=$(awk '$1 == "eb_keep_logs_last_prune_timestamp_seconds" { if (++n > 1 || $2 !~ /^[0-9]+$/) exit 2; v=$2 } END { if (n) print v }' "${file}")
        if [ "$?" -ne 0 ]; then
            echo "eb-keep-logs: cannot update metrics file ${file}: invalid metrics" >&2
            exec {fd}>&-
            return 0
        fi
        last=${value:-0}
    fi
    if ! new_logs=$(_add_u64 "${logs}" "${add_logs}") ||
        ! new_bytes=$(_add_u64 "${bytes}" "${add_bytes}"); then
        echo "eb-keep-logs: cannot update metrics file ${file}: counter overflow" >&2
        exec {fd}>&-
        return 0
    fi
    logs="${new_logs}"
    bytes="${new_bytes}"
    # Choose completion time only after taking the metrics lock. Keep a later
    # completion already recorded by a concurrent, out-of-order rotation.
    [ "${prune}" != "now" ] || prune=$(date +%s)
    if [ -n "${prune}" ] && _u64_gt "${prune}" "${last}"; then
        last="${prune}"
    fi
    tmp=$(mktemp -- "${dir}/.${base}.XXXXXXXX.tmp") || {
        echo "eb-keep-logs: cannot update metrics file ${file}: cannot create temporary file" >&2
        exec {fd}>&-
        return 0
    }
    if ! cat > "${tmp}" <<EOF
# HELP eb_keep_logs_logs_kept_total Log files kept by eb-keep-logs.
# TYPE eb_keep_logs_logs_kept_total counter
eb_keep_logs_logs_kept_total ${logs}
# HELP eb_keep_logs_bytes_kept_total Bytes written to kept log files by eb-keep-logs.
# TYPE eb_keep_logs_bytes_kept_total counter
eb_keep_logs_bytes_kept_total ${bytes}
# HELP eb_keep_logs_last_prune_timestamp_seconds Unix timestamp of the last completed eb-keep-logs rotation.
# TYPE eb_keep_logs_last_prune_timestamp_seconds gauge
eb_keep_logs_last_prune_timestamp_seconds ${last}
EOF
    then
        rm -f -- "${tmp}"
        exec {fd}>&-
        return 0
    fi
    if { [ -e "${file}" ] && ! chmod --reference="${file}" -- "${tmp}"; } ||
        { [ ! -e "${file}" ] && ! chmod 644 "${tmp}"; }; then
        echo "eb-keep-logs: cannot update metrics file ${file}: cannot set temporary file mode" >&2
        rm -f -- "${tmp}"
        exec {fd}>&-
        return 0
    fi
    if ! sync -f "${tmp}" || ! mv -f -- "${tmp}" "${file}"; then
        echo "eb-keep-logs: cannot update metrics file ${file}: cannot replace it" >&2
        rm -f -- "${tmp}"
    elif ! sync -f "${dir}"; then
        echo "eb-keep-logs: cannot update metrics file ${file}: cannot sync its directory" >&2
    fi
    exec {fd}>&-
}

cmd_failed() {
    local pos=() syslog_opt="" have_syslog=0 metrics_file="" have_metrics=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --syslog)
                [ $# -ge 2 ] || die "--syslog needs a target"
                syslog_opt="$2"; have_syslog=1; shift 2 ;;
            --syslog=*)
                syslog_opt="${1#*=}"; have_syslog=1; shift ;;
            --metrics-file)
                [ $# -ge 2 ] || die "--metrics-file needs a path"
                metrics_file="$2"; have_metrics=1; shift 2 ;;
            --metrics-file=*)
                metrics_file="${1#*=}"; have_metrics=1; shift ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    [ ${#pos[@]} -ge 3 ] || die "failed needs STATUS NAME LOGDIR [TMP_LOGDIR]"
    local status="${pos[0]}" name="${pos[1]}" logdir="${pos[2]}" explicit_logdir="${pos[3]:-}"
    local src dest
    [[ "${status}" =~ ^[0-9]+$ ]] || die "STATUS must be a number, not '${status}'"
    [ -d "${logdir}" ] || die "LOGDIR ${logdir} is not a directory"
    [ "${have_metrics}" -eq 0 ] || [ -n "${metrics_file}" ] || die "--metrics-file needs a path"
    local syslog_target=""
    _resolve_syslog_pen
    if [ "${have_syslog}" -eq 1 ]; then
        _resolve_syslog "${syslog_opt}"
        syslog_target="${SYSLOG_TARGET}"
    elif [ -n "${EB_KEEP_LOGS_SYSLOG:-}" ]; then
        _resolve_syslog "${EB_KEEP_LOGS_SYSLOG}"
        syslog_target="${SYSLOG_TARGET}"
    fi
    logdir=$(_joinable "${logdir}")
    if [ "${status}" -eq 0 ]; then
        _update_metrics "${metrics_file}" 0 0 ""
        return 0
    fi
    # The failed lines the kept copies hold are also in the build's own stdout
    # log and in the logs EasyBuild writes to TMP_LOGDIR. Close both to others,
    # TMP_LOGDIR with the regular files directly in it, not through a symbolic
    # link; TMP_LOGDIR only when it lies below LOGDIR, as the documented layout
    # puts it.
    local stdout_log="${logdir}/${name}.stdout.log" real_logdir real_tmp
    if [ -f "${stdout_log}" ] && [ ! -L "${stdout_log}" ]; then
        chmod o-rwx "${stdout_log}"
    fi
    if [ -n "${explicit_logdir}" ] && [ -d "${explicit_logdir}" ] && [ ! -L "${explicit_logdir}" ] &&
        real_logdir=$(realpath -e "${logdir:-/}") && real_tmp=$(realpath -e "${explicit_logdir}"); then
        case "${real_tmp}" in
            "${real_logdir%/}"/?*)
                chmod o-rwx "${explicit_logdir}"
                find "${explicit_logdir}" -mindepth 1 -maxdepth 1 -type f -exec chmod o-rwx {} +
                ;;
        esac
    fi
    if ! command -v eb >/dev/null 2>&1; then
        echo "No EasyBuild log to keep for ${name}: eb is not on PATH."
        _emit_failed_syslog "${syslog_target}" "${status}" "${name}" "${logdir}" 0 0 0 "no-eb"
        _update_metrics "${metrics_file}" 0 0 ""
        return 0
    fi
    local rc=0
    if [ -n "${explicit_logdir}" ]; then
        src=$(_last_log --tmp-logdir="${explicit_logdir}") || rc=$?
    else
        src=$(_last_log) || rc=$?
    fi
    if [ "${rc}" -ne 0 ]; then
        echo "No EasyBuild log to keep for ${name}: eb --last-log exited ${rc}."
        _emit_failed_syslog "${syslog_target}" "${status}" "${name}" "${logdir}" 0 0 0 "last-log-failed"
        _update_metrics "${metrics_file}" 0 0 ""
        return 0
    fi
    if [ -z "${src}" ] || [ ! -f "${src}" ]; then
        echo "No EasyBuild log to keep for ${name}."
        _emit_failed_syslog "${syslog_target}" "${status}" "${name}" "${logdir}" 0 0 0 "no-log"
        _update_metrics "${metrics_file}" 0 0 ""
        return 0
    fi
    # Without TMP_LOGDIR, `eb --last-log` names the newest log in EasyBuild's
    # default place, which can be a later build's. Nothing is taken from that
    # log; the build's own stdout log still names its failing command.
    local foreign="" ebout_kept=0 cmd_kept=0 meson_kept=0 kept_bytes=0
    if [ -z "${explicit_logdir}" ] && grep -q 'processing EasyBuild easyconfig ' "${src}" &&
        ! grep -qF -- "${name}.eb" "${src}"; then
        echo "No EasyBuild log to keep for ${name}: ${src} is another build's log."
        foreign=1
    else
        dest="${logdir}/${name}.failed.ebout.log"
        cp "${src}" "${dest}"
        _private "${dest}" "${logdir}"
        echo "Failed build log: ${dest}"
        ebout_kept=1
        kept_bytes=$(_add_u64 "${kept_bytes}" "$(stat -c %s "${dest}")")
    fi

    # The failing command's own output holds the diagnostic beyond EasyBuild's
    # printed tail. Only the final command's text streams are kept, and from
    # the session log only when that command did not complete successfully;
    # only from inside EASYBUILD_TMPDIR and owned by the build account.
    local command_output command_root resolved_output stream
    command_output=""
    if [ -f "${logdir}/${name}.stdout.log" ]; then
        command_output=$(grep -oE '/[^[:space:]]*/run-shell-cmd-output/[^/[:space:]]+/out\.txt' "${logdir}/${name}.stdout.log" | tail -n 1)
    fi
    if [ -z "${command_output}" ] && [ -z "${foreign}" ]; then
        command_output=$(_failed_command_output "${src}")
    fi
    command_root="${command_output%/out.txt}"
    if [ -n "${command_output}" ] && [ -z "${EASYBUILD_TMPDIR:-}" ]; then
        echo "Failed command output not kept: EASYBUILD_TMPDIR is not set."
    elif [ -n "${command_output}" ]; then
        # EasyBuild names the streams through EASYBUILD_TMPDIR as it was
        # given, so both are compared resolved.
        local tmp_real stream_path
        tmp_real=$(realpath -e "${EASYBUILD_TMPDIR}" 2>/dev/null)
        for stream in out err; do
            stream_path="${command_root}/${stream}.txt"
            [ ! -L "${stream_path}" ] && [ -f "${stream_path}" ] || continue
            resolved_output=$(realpath -e "${stream_path}" 2>/dev/null) || continue
            if [ -z "${tmp_real}" ] || [[ "${resolved_output}" != "${tmp_real%/}/"* ]]; then
                echo "Failed command output not kept: ${stream_path} is not under EASYBUILD_TMPDIR."
                continue
            fi
            if [ "$(stat -c '%u' "${resolved_output}")" != "$(id -u)" ]; then
                echo "Failed command output not kept: ${stream_path} belongs to another user."
                continue
            fi
            dest="${logdir}/${name}.failed.command-${stream}.txt"
            cp "${resolved_output}" "${dest}" || continue
            chmod 600 "${dest}"
            _list "${dest}" "${logdir}"
            echo "Failed command output: ${dest}"
            cmd_kept=$((cmd_kept + 1))
            kept_bytes=$(_add_u64 "${kept_bytes}" "$(stat -c %s "${dest}")")
        done
    fi

    if [ -n "${foreign}" ]; then
        local reason="other-build"
        [ "${cmd_kept}" -gt 0 ] && reason="kept"
        _emit_failed_syslog "${syslog_target}" "${status}" "${name}" "${logdir}" 0 "${cmd_kept}" 0 "${reason}"
        _update_metrics "${metrics_file}" "${cmd_kept}" "${kept_bytes}" ""
        return 0
    fi
    # A meson test step prints only the last 100 lines of a failing test; the
    # full output is meson-logs/testlog.txt in the build directory. A testlog
    # whose tests all passed is not the failure.
    local meson_dir testlog
    meson_dir=$(tr '\n' ' ' < "${src}" | grep -oP 'meson test -C\s+\K[^[:space:]]+' | tail -n 1)
    testlog="${meson_dir}/meson-logs/testlog.txt"
    if [ -n "${meson_dir}" ] && [ -f "${testlog}" ] && ! _meson_passed "${testlog}"; then
        dest="${logdir}/${name}.failed.meson-testlog.txt"
        cp "${testlog}" "${dest}"
        _private "${dest}" "${logdir}"
        echo "Failed meson test log: ${dest}"
        meson_kept=1
        kept_bytes=$(_add_u64 "${kept_bytes}" "$(stat -c %s "${dest}")")
    fi
    local reason="no-log"
    [ $((ebout_kept + cmd_kept + meson_kept)) -gt 0 ] && reason="kept"
    _emit_failed_syslog "${syslog_target}" "${status}" "${name}" "${logdir}" "${ebout_kept}" "${cmd_kept}" "${meson_kept}" "${reason}"
    _update_metrics "${metrics_file}" "$((ebout_kept + cmd_kept + meson_kept))" "${kept_bytes}" ""
    return 0
}

# Days since a run directory's name, YYYYMMDD_HHMMSS; empty when the name is
# not a run directory. The name, not the mtime: compressing the run's logs
# moves the mtime of the directory they are in, where a chmod changes only
# the ctime.
_run_age_days() {
    local base date now start
    base=$(basename "$1")
    [[ "${base}" =~ ^([0-9]{8})_[0-9]{6}$ ]] || return 1
    date="${BASH_REMATCH[1]}"
    start=$(date -d "${date}" +%s 2>/dev/null) || return 1
    now=${EB_KEEP_LOGS_NOW:-$(date +%s)}
    echo $(( (now - start) / 86400 ))
}

# "/NAME" for each run directly under ROOT that this rotate writes into: the
# run holding its stdout or stderr when either is a file and, as srun passes
# the output on over a pipe, the run holding EB_PIPELINE_LOG_DIR, the log
# directory eb-pipeline exports. Such a run is still going.
_own_runs() {
    local root fd
    root=$(realpath -e -- "$1") || return 0
    root="${root%/}"
    for fd in 1 2; do
        [ -f "/proc/$$/fd/${fd}" ] && _run_of "${root}" "$(readlink -e -- "/proc/$$/fd/${fd}")"
    done
    [ -n "${EB_PIPELINE_LOG_DIR:-}" ] && _run_of "${root}" "$(readlink -e -- "${EB_PIPELINE_LOG_DIR}")"
    return 0
}

# "/NAME" when PATH lies in NAME directly under ROOT.
_run_of() {
    local rest
    case "$2" in
        "$1/"?*) rest="${2#"$1/"}"; printf '/%s' "${rest%%/*}" ;;
    esac
}

# "/NAME" for each run directly under ROOT that a process has a file in open
# for writing, of the processes whose descriptors this one may read in /proc:
# a build that is still going, whichever run it writes into. A link
# /proc/PID/fd/N has its owner's write bit when N is open for writing; for a
# file removed since, the link names the path it had, with " (deleted)" added.
_written_runs() {
    local root target
    root=$(realpath -e -- "$1") || return 0
    root="${root%/}"
    while IFS= read -r -d '' target; do
        _run_of "${root}" "${target}"
    done < <(find /proc/[0-9]*/fd -mindepth 1 -maxdepth 1 -type l -perm -u=w -printf '%l\0' 2>/dev/null)
    return 0
}

# Hold an exclusive flock on the lock file LOCK until this rotate exits,
# waiting up to SECONDS for another holder; exit 75 when it does not let go.
# Opened for reading when it cannot be opened for writing, by a user who may
# not write ROOT. On a file system that cannot lock, rotate without it.
_lock_rotate() {
    local lock="$1" seconds="$2" fd rc=0
    if [ -L "${lock}" ] || { [ -e "${lock}" ] && [ ! -f "${lock}" ]; }; then
        die "cannot lock ${lock}"
    fi
    { exec {fd}>>"${lock}"; } 2>/dev/null || { exec {fd}<"${lock}"; } 2>/dev/null || die "cannot lock ${lock}"
    flock -w "${seconds}" -E 75 "${fd}" || rc=$?
    case "${rc}" in
        0) ;;
        75) echo "eb-keep-logs: another rotate holds the lock ${lock}; gave up after ${seconds} s (--lock-timeout)" >&2
            exit 75 ;;
        *) echo "eb-keep-logs: cannot lock ${lock}; rotating without the lock" >&2 ;;
    esac
}

cmd_rotate() {
    local root="" compress_after="" delete_after="" lock_timeout="" syslog_opt="" have_syslog=0 dry_run=0 metrics_file="" have_metrics=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --compress-after) compress_after="${2:-}"; shift 2 ;;
            --compress-after=*) compress_after="${1#*=}"; shift ;;
            --delete-after) delete_after="${2:-}"; shift 2 ;;
            --delete-after=*) delete_after="${1#*=}"; shift ;;
            --dry-run) dry_run=1; shift ;;
            --lock-timeout)
                [ $# -ge 2 ] || die "--lock-timeout needs a number of seconds"
                lock_timeout="$2"; shift 2 ;;
            --lock-timeout=*) lock_timeout="${1#*=}"; shift ;;
            --syslog)
                [ $# -ge 2 ] || die "--syslog needs a target"
                syslog_opt="$2"; have_syslog=1; shift 2 ;;
            --syslog=*) syslog_opt="${1#*=}"; have_syslog=1; shift ;;
            --metrics-file)
                [ $# -ge 2 ] || die "--metrics-file needs a path"
                metrics_file="$2"; have_metrics=1; shift 2 ;;
            --metrics-file=*) metrics_file="${1#*=}"; have_metrics=1; shift ;;
            -*) die "unknown option $1" ;;
            *) [ -z "${root}" ] || die "rotate takes one ROOT"; root="$1"; shift ;;
        esac
    done
    [ -n "${root}" ] || die "rotate needs ROOT"
    [ -d "${root}" ] || die "ROOT ${root} is not a directory"
    [ "${have_metrics}" -eq 0 ] || [ -n "${metrics_file}" ] || die "--metrics-file needs a path"
    [[ "${compress_after}" =~ ^[0-9]+$ ]] || die "--compress-after needs a number of days"
    if [ -n "${delete_after}" ]; then
        [[ "${delete_after}" =~ ^[0-9]+$ ]] || die "--delete-after needs a number of days"
        [ "${delete_after}" -gt "${compress_after}" ] || die "--delete-after must be later than --compress-after"
    fi
    if [ -n "${lock_timeout}" ]; then
        [[ "${lock_timeout}" =~ ^[0-9]+$ ]] || die "--lock-timeout needs a number of seconds"
        lock_timeout="${lock_timeout#"${lock_timeout%%[!0]*}"}"
        lock_timeout="${lock_timeout:-0}"
        # flock(1) cannot set a timer for 10^19 seconds; this is 31 years.
        [ "${#lock_timeout}" -le 9 ] || lock_timeout=999999999
    else
        lock_timeout=600
    fi
    local syslog_target=""
    _resolve_syslog_pen
    if [ "${have_syslog}" -eq 1 ]; then
        _resolve_syslog "${syslog_opt}"
        syslog_target="${SYSLOG_TARGET}"
    elif [ -n "${EB_KEEP_LOGS_SYSLOG:-}" ]; then
        _resolve_syslog "${EB_KEEP_LOGS_SYSLOG}"
        syslog_target="${SYSLOG_TARGET}"
    fi
    [ "${dry_run}" -eq 1 ] || _lock_rotate "$(_joinable "${root}")/.eb-keep-logs-rotate.lock" "${lock_timeout}"
    local run age file list tmp path compressed=0 deleted=0 live
    live="$(_own_runs "${root}")$(_written_runs "${root}")/"
    for run in "$(_joinable "${root}")"/*/; do
        run="${run%/}"
        [ -d "${run}" ] && [ ! -L "${run}" ] || continue
        age=$(_run_age_days "${run}") || continue
        # A later rotate takes a run that is still written into, by this
        # rotate or by a build that is still going.
        case "${live}" in *"/${run##*/}/"*) continue ;; esac
        if [ -n "${delete_after}" ] && [ "${age}" -ge "${delete_after}" ]; then
            if [ "${dry_run}" -eq 1 ]; then
                echo "delete ${run}"
                deleted=$((deleted + 1))
                continue
            fi
            rm -rf -- "${run}"
            deleted=$((deleted + 1))
            continue
        fi
        [ "${age}" -ge "${compress_after}" ] || continue
        if [ "${dry_run}" -eq 1 ]; then
            while IFS= read -r -d '' file; do
                if [ -e "${file}.gz" ] || [ -L "${file}.gz" ]; then continue; fi
                if [ "$(stat -c '%h' -- "${file}" 2>/dev/null || echo 2)" -gt 1 ]; then continue; fi
                echo "compress $(realpath "${file%/*}")/${file##*/}"
                compressed=$((compressed + 1))
            done < <(find "${run}" -type f \( -name '*.log' -o -name '*.txt' \) -print0 | LC_ALL=C sort -z)
            continue
        fi
        while IFS= read -r -d '' file; do
            path="$(realpath "${file%/*}")/${file##*/}"
            # gzip keeps the file's mode, so a closed log stays closed.
            gzip -9 -- "${file}" || continue
            compressed=$((compressed + 1))
            # A .licensed-logs in the run names the file by path; follow it.
            # The new list is written beside the old one, under a name of its
            # own, and renamed over it, so a reader sees one list or the other.
            while IFS= read -r -d '' list; do
                tmp=$(mktemp -- "${list%/*}/.licensed-logs.XXXXXXXX") || continue
                { awk -v p="${path}" '$0 == p { $0 = p ".gz" } { print }' "${list}" > "${tmp}" &&
                    chmod --reference="${list}" -- "${tmp}" && mv -f -- "${tmp}" "${list}"; } ||
                    rm -f -- "${tmp}"
            done < <(find "${run}" -name .licensed-logs -type f -print0)
        done < <(find "${run}" -type f \( -name '*.log' -o -name '*.txt' \) -print0)
    done
    local summary
    if [ "${dry_run}" -eq 1 ]; then
        summary="eb-keep-logs rotate dry-run: $(_count "${compressed}" file) would be compressed, $(_count "${deleted}" run) would be deleted under ${root}"
    else
        summary="eb-keep-logs rotate: $(_count "${compressed}" file) compressed, $(_count "${deleted}" run) deleted under ${root}"
    fi
    echo "${summary}"
    [ "${dry_run}" -eq 1 ] && return 0
    _emit_syslog "${syslog_target}" 6 "EB_ROTATE_DONE" "${summary}" \
        "P:cmd=rotate" "P:root=${root}" "P:compressed=${compressed}" "P:deleted=${deleted}" \
        "J:EB_KEEP_CMD=rotate" "J:EB_ROTATE_ROOT=${root}" "J:EB_ROTATE_COMPRESSED=${compressed}" "J:EB_ROTATE_DELETED=${deleted}"
    _update_metrics "${metrics_file}" 0 0 "now"
}

case "${1:-}" in
    -h|--help) usage ;;
    --version) echo "eb-keep-logs ${VERSION}" ;;
    failed) shift; cmd_failed "$@" ;;
    rotate) shift; cmd_rotate "$@" ;;
    why | history | failures | loads | runs | used | usage | pending | test-bundle | test-compare | lifecycle) die "$1 is in the Zig build only" ;;
    "") usage; exit 2 ;;
    *) die "unknown command '$1' (failed, rotate, why, history, failures, loads, runs, used, usage, pending, test-bundle, test-compare, lifecycle, --help)" ;;
esac
