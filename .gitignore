.zig-cache/
zig-out/
zig-pkg/

# Documentation build (docs-plan template): generated, never committed.
/docs/build/
/docs/source/**/*.rst
/docs/source/reference/api/
/docs/source/**/*.png
/docs/source/**/*.svg
/docs/source/**/*.jpg
/docs/source/**/*.webp
!/docs/source/_static/**
/docs/**/__pycache__/
/.pixi/
/.lycheecache

# Recorded stderr of the stability test; a global *.err ignore must not drop it.
!tests/golden/**/*.err
